{
  "jobId": "sa-test-acad-05-xc-setup",
  "title": "Reference XC.dwg: units and layer",
  "description": "Prepares the reference drawing XC.dwg (inches, layer A-WALL from the standard). Run in XC.dwg.",
  "app": "autocad",
  "document": {
    "path": "C:/SA-Test/autocad/XC.dwg"
  },
  "units": {
    "length": "in"
  },
  "standard": "data/standards/us-ncs-style.json",
  "ops": [
    {
      "id": "units",
      "op": "doc.setup",
      "args": {
        "insUnits": "in",
        "measurement": "imperial"
      }
    },
    {
      "id": "layer",
      "op": "layer.ensure",
      "args": {
        "layers": [
          {
            "name": "A-WALL"
          }
        ]
      }
    }
  ]
}
