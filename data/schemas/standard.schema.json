{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "standard.schema.json",
  "title": "Project standard",
  "description": "Layer naming, layer list, styles, sheet and file naming, status and revision codes, scales and text heights for one project. Loaded by SA.Core.Standards.StandardLoader, which also rejects unknown members.",
  "type": "object",
  "required": [ "id", "name" ],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "id": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1 },
    "version": { "type": "string" },
    "description": { "type": "string" },
    "jurisdiction": { "type": "string" },
    "notes": { "type": [ "string", "array" ] },
    "units": {
      "type": "object", "additionalProperties": false, "required": [ "length" ],
      "properties": { "length": { "$ref": "#/$defs/lengthUnit" } }
    },
    "codeLists": {
      "description": "Named code lists that fields refer to with codeList.",
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/codes" }
    },
    "layerNaming": {
      "type": "object",
      "required": [ "scheme" ],
      "properties": { "scheme": { "enum": [ "us", "iso13567" ] } },
      "if": { "properties": { "scheme": { "const": "us" } } },
      "then": { "$ref": "#/$defs/usLayerScheme" },
      "else": { "$ref": "#/$defs/isoLayerScheme" }
    },
    "layers": { "type": "array", "items": { "$ref": "#/$defs/layer" } },
    "textStyles": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false, "required": [ "name", "font" ],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "font": { "type": "string", "minLength": 1 },
          "height": { "type": "number", "minimum": 0, "description": "0 means variable height" },
          "widthFactor": { "type": "number", "exclusiveMinimum": 0 },
          "obliqueAngle": { "type": "number" },
          "annotative": { "type": "boolean" },
          "use": { "type": "string" }
        }
      }
    },
    "dimStyles": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false, "required": [ "name" ],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "description": { "type": "string" },
          "annotative": { "type": "boolean" },
          "settings": {
            "description": "Named settings: AutoCAD dimension variables (DIMTXT...) or Revit type parameters by name.",
            "type": "object",
            "additionalProperties": { "type": [ "number", "string", "boolean" ] }
          }
        }
      }
    },
    "sheetNumbering": { "$ref": "#/$defs/namingRule" },
    "fileNaming": { "$ref": "#/$defs/namingRule" },
    "viewNaming": { "$ref": "#/$defs/namingRule", "description": "Rule for view names (Revit views; checks with scheme 'view')." },
    "layerRoles": {
      "description": "The layer for each kind of object the engines place without a layer from the job. Each should be in layers.",
      "type": "object", "additionalProperties": false,
      "properties": {
        "description": { "type": "string" },
        "viewport": { "type": "string", "minLength": 1, "description": "Viewport frames; a non-plotting layer" },
        "xref": { "type": "string", "minLength": 1, "description": "External reference inserts" },
        "titleBlock": { "type": "string", "minLength": 1, "description": "The title block insert" }
      }
    },
    "purge": {
      "type": "object", "additionalProperties": false, "required": [ "keep" ],
      "properties": {
        "description": { "type": "string" },
        "keep": { "type": "array", "items": { "type": "string", "minLength": 1 }, "description": "Names a purge never removes, besides everything else the standard names" }
      }
    },
    "statusCodes": { "$ref": "#/$defs/codes" },
    "revisionCodes": {
      "type": "object", "additionalProperties": false, "required": [ "formats" ],
      "properties": {
        "description": { "type": "string" },
        "formats": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "additionalProperties": false, "required": [ "name", "pattern" ],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "pattern": { "type": "string", "description": "Regular expression matched against the whole code" },
              "description": { "type": "string" },
              "example": { "type": "string" }
            }
          }
        }
      }
    },
    "scales": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false, "required": [ "name" ],
        "properties": {
          "name": { "type": "string", "minLength": 1, "description": "\"1:100\" or \"1/4\\\" = 1'-0\\\"\"; ratio is computed from it when omitted" },
          "ratio": { "type": "number", "exclusiveMinimum": 0, "description": "Model length per paper length" },
          "use": { "type": "string" }
        }
      }
    },
    "scaleRules": {
      "description": "How scales may be combined on a sheet. Optional; without it checks sheet_scales_uniform report nothing",
      "type": "object", "additionalProperties": false,
      "properties": {
        "description": { "type": "string" },
        "oneScalePerSheet": { "type": "boolean", "description": "Every view or viewport on one sheet or layout shares one scale" },
        "exemptViewTypes": { "type": "array", "items": { "type": "string", "minLength": 1 }, "description": "Revit ViewType names left out of the comparison, e.g. Legend, DraftingView" },
        "exemptSheets": { "type": "string", "minLength": 1, "description": "Regular expression; sheets (Revit sheet numbers, AutoCAD layout names) that match are left out" }
      }
    },
    "textHeights": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false, "required": [ "name", "plotted" ],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "plotted": { "type": "number", "exclusiveMinimum": 0 },
          "unit": { "$ref": "#/$defs/lengthUnit" },
          "use": { "type": "string" }
        }
      }
    },
    "titleBlock": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "description": { "type": "string" },
        "blockName": { "type": "string", "minLength": 1, "description": "AutoCAD block name of the title block" },
        "familyType": { "type": "string", "pattern": "^.+\\S\\s:\\s\\S.+$", "description": "Revit title block type, written \"Family : Type\"" },
        "fields": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false, "required": [ "name" ],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "description": { "type": "string" },
              "required": { "type": "boolean" },
              "source": { "type": "string" }
            }
          }
        }
      }
    },
    "patterns": {
      "description": "Named regular expressions for checks (param standardPattern).",
      "type": "object",
      "additionalProperties": { "type": "string" }
    }
  },
  "$defs": {
    "lengthUnit": { "enum": [ "mm", "cm", "m", "in", "ft" ] },
    "code": {
      "oneOf": [
        { "type": "string", "minLength": 1 },
        {
          "type": "object", "additionalProperties": false, "required": [ "code" ],
          "properties": { "code": { "type": "string", "minLength": 1 }, "name": { "type": "string" }, "description": { "type": "string" } }
        }
      ]
    },
    "codes": { "type": "array", "items": { "$ref": "#/$defs/code" } },
    "case": { "enum": [ "any", "upper", "lower" ] },
    "usLayerScheme": {
      "type": "object", "additionalProperties": false, "required": [ "scheme", "discipline", "majorGroup" ],
      "properties": {
        "scheme": { "const": "us" },
        "description": { "type": "string" },
        "examples": { "type": "array", "items": { "type": "string" } },
        "separator": { "type": "string", "minLength": 1, "maxLength": 1 },
        "case": { "$ref": "#/$defs/case" },
        "discipline": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "codes": { "$ref": "#/$defs/codes" }, "codeList": { "type": "string" }, "description": { "type": "string" },
            "modifiers": {
              "type": "object", "additionalProperties": false,
              "properties": { "codes": { "$ref": "#/$defs/codes" }, "codeList": { "type": "string" }, "description": { "type": "string" } }
            }
          }
        },
        "majorGroup": {
          "type": "object", "additionalProperties": false,
          "properties": { "codes": { "$ref": "#/$defs/codes" }, "codeList": { "type": "string" }, "length": { "type": "integer", "minimum": 1 }, "description": { "type": "string" } }
        },
        "minorGroup": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "codes": { "$ref": "#/$defs/codes" }, "codeList": { "type": "string" },
            "length": { "type": "integer", "minimum": 2 }, "maxCount": { "type": "integer", "minimum": 0 },
            "allowOther": { "type": "boolean" }, "description": { "type": "string" }
          }
        },
        "status": {
          "type": "object", "additionalProperties": false,
          "properties": { "codes": { "$ref": "#/$defs/codes" }, "codeList": { "type": "string" }, "description": { "type": "string" } }
        }
      }
    },
    "isoLayerScheme": {
      "type": "object", "additionalProperties": false, "required": [ "scheme", "fields" ],
      "properties": {
        "scheme": { "const": "iso13567" },
        "description": { "type": "string" },
        "examples": { "type": "array", "items": { "type": "string" } },
        "filler": { "type": "string", "minLength": 1, "maxLength": 1 },
        "case": { "$ref": "#/$defs/case" },
        "fields": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "additionalProperties": false, "required": [ "name", "length" ],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "length": { "type": "integer", "minimum": 1 },
              "required": { "type": "boolean" },
              "codes": { "$ref": "#/$defs/codes" },
              "codeList": { "type": "string" },
              "match": { "enum": [ "exact", "prefix" ] },
              "description": { "type": "string" }
            }
          }
        },
        "userDefined": {
          "type": "object", "additionalProperties": false,
          "properties": { "allowed": { "type": "boolean" }, "maxLength": { "type": "integer", "minimum": 1 }, "description": { "type": "string" } }
        }
      }
    },
    "namingRule": {
      "type": "object", "additionalProperties": false, "required": [ "fields" ],
      "properties": {
        "description": { "type": "string" },
        "case": { "$ref": "#/$defs/case" },
        "extensions": { "type": "array", "items": { "type": "string", "pattern": "^\\." } },
        "examples": { "type": "array", "items": { "type": "string" } },
        "fields": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "additionalProperties": false, "required": [ "name" ],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "separator": { "type": "string", "description": "Literal text written before this field when an earlier field is present" },
              "codes": { "$ref": "#/$defs/codes" },
              "codeList": { "type": "string" },
              "pattern": { "type": "string", "description": "Regular expression the whole field must match" },
              "length": { "type": "integer", "minimum": 1 },
              "minLength": { "type": "integer", "minimum": 1 },
              "maxLength": { "type": "integer", "minimum": 1 },
              "optional": { "type": "boolean" },
              "description": { "type": "string" }
            },
            "not": { "required": [ "codes", "codeList" ] }
          }
        }
      }
    },
    "layer": {
      "type": "object", "additionalProperties": false, "required": [ "name", "color" ],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "color": {
          "oneOf": [
            { "type": "integer", "minimum": 1, "maximum": 255 },
            { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
            { "type": "string", "pattern": "^\\s*\\d{1,3}\\s*,\\s*\\d{1,3}\\s*,\\s*\\d{1,3}\\s*$" }
          ]
        },
        "linetype": { "type": "string", "minLength": 1 },
        "lineweight": {
          "oneOf": [
            { "const": "default" },
            { "enum": [ 0, 0.05, 0.09, 0.13, 0.15, 0.18, 0.2, 0.25, 0.3, 0.35, 0.4, 0.5, 0.53, 0.6, 0.7, 0.8, 0.9, 1, 1.06, 1.2, 1.4, 1.58, 2, 2.11 ] }
          ]
        },
        "plot": { "type": "boolean" },
        "description": { "type": "string" },
        "transparency": { "type": "integer", "minimum": 0, "maximum": 90 }
      }
    }
  }
}
