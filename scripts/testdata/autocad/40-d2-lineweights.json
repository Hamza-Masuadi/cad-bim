            "lineweight": 0.25
          },
          {
            "name": "A-DOOR",
            "lineweight": 0.25
          },
          {
            "name": "A-AREA",
            "lineweight": 0.25
          },
          {
            "name": "A-AREA-IDEN",
            "lineweight": 0.25
          },
          {
            "name": "A-ANNO-DIMS",
            "lineweight": 0.25
          },
          {
            "name": "A-ANNO-TEXT",
            "lineweight": 0.25
          },
          {
            "name": "G-ANNO-TTLB",
            "lineweight": 0.25
          },
          {
            "name": "G-ANNO-NPLT",
