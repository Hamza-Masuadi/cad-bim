{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "design-data.schema.json",
  "title": "Design data file",
  "description": "Dimensional and numeric design rules with their public sources. One file per topic under data/design/. Values are metric; the imperial object carries the figure in US units. Code compliance stays the user's to confirm.",
  "type": "object",
  "required": [ "topic", "retrieved", "entries" ],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "topic": { "type": "string", "minLength": 1 },
    "retrieved": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$", "description": "Date the sources were read" },
    "entries": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/entry" } }
  },
  "$defs": {
    "nullableNumber": { "type": [ "number", "null" ] },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [ "id", "quantity", "value", "min", "max", "unit", "imperial", "applies_to", "jurisdiction", "source", "note", "confidence" ],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_]*(\\.[a-z0-9][a-z0-9_]*)+$", "description": "topic.jurisdiction.thing[.qualifier], unique across all files" },
        "quantity": { "type": "string", "minLength": 1 },
        "value": { "$ref": "#/$defs/nullableNumber", "description": "The figure in the metric unit; null for a rule-only entry, which then has a formula" },
        "min": { "$ref": "#/$defs/nullableNumber", "description": "Lower limit, or null when there is none" },
        "max": { "$ref": "#/$defs/nullableNumber", "description": "Upper limit, or null when there is none" },
        "unit": {
          "type": "string",
          "minLength": 1,
          "description": "Metric unit of value, min and max: mm, m, m2, s, deg, N, percent, count, persons, risers, scale factor, \"mm per person\", or \"1:n\" for a gradient where the number is n"
        },
        "imperial": {
          "type": "object",
          "additionalProperties": false,
          "required": [ "value", "unit", "converted" ],
          "properties": {
            "value": { "$ref": "#/$defs/nullableNumber" },
            "unit": { "type": "string", "minLength": 1 },
            "converted": { "type": "boolean", "description": "true when computed from the metric figure, false when the source states it" }
          }
        },
        "applies_to": { "type": "string", "minLength": 1 },
        "jurisdiction": { "type": "string", "minLength": 1 },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": [ "title", "publisher", "clause", "url" ],
          "properties": {
            "title": { "type": "string", "minLength": 1 },
            "publisher": { "type": "string", "minLength": 1 },
            "edition": { "type": "string" },
            "clause": { "type": "string" },
            "url": { "type": "string", "pattern": "^https?://" }
          }
        },
        "note": { "type": "string" },
        "confidence": { "enum": [ "read_in_source", "secondary" ], "description": "read_in_source: read in the cited document; secondary: taken from a restatement" },
        "formula": { "type": [ "string", "null" ], "description": "A rule the figure comes from, e.g. \"ceil(0.02 * total)\"" }
      },
      "if": { "properties": { "value": { "type": "null" } } },
      "then": { "required": [ "formula" ], "properties": { "formula": { "type": "string", "minLength": 1 } } }
    }
  }
}
